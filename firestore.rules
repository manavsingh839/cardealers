rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if caller is platform Super Admin
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'admin' || 
         request.auth.token.email == 'admin@cardealer.com');
    }

    // 1. Dealers collection
    match /dealers/{dealerId} {
      // Anyone can read approved dealers
      allow read: if resource.data.status == 'approved' || isAdmin() || 
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      
      // Dealer can create own profile on registration
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Dealer can only update their own non-sensitive profile info
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      
      // Only Admin can delete or modify verification & subscription status
      allow delete: if isAdmin();
    }

    // 2. Cars collection
    match /cars/{carId} {
      // Public can read available, approved cars
      allow read: if (resource.data.status == 'available' && resource.data.isApproved == true) || 
        isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.dealerId);

      // Dealer can add car if authenticated and belongs to their dealership
      allow create: if isAuthenticated() && 
        (request.resource.data.dealerId == request.auth.uid || isAdmin());

      // Dealer can update or mark sold their own cars only
      allow update: if (isAuthenticated() && resource.data.dealerId == request.auth.uid) || isAdmin();

      // Dealer can delete their own car; Admin can delete any
      allow delete: if (isAuthenticated() && resource.data.dealerId == request.auth.uid) || isAdmin();
    }

    // 3. Customer Enquiries (CRM Leads)
    match /enquiries/{enquiryId} {
      // Public customers can submit enquiries
      allow create: if true;

      // STRICT TENANT ISOLATION:
      // Dealer A CANNOT read or update Dealer B's enquiries!
      allow read, update: if (isAuthenticated() && resource.data.dealerId == request.auth.uid) || isAdmin();

      // Only Admin can delete enquiry logs
      allow delete: if isAdmin();
    }

    // 4. Analytics Events
    match /analytics_events/{eventId} {
      // Public can log view/click events
      allow create: if true;
      
      // Only corresponding dealer or Admin can view analytics
      allow read: if (isAuthenticated() && resource.data.dealerId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // 5. Subscription Plans
    match /subscription_plans/{planId} {
      // Public can read available plans
      allow read: if true;
      // Only Admin can create, modify, or delete plans
      allow write: if isAdmin();
    }

    // 6. Platform Settings
    match /admin_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
